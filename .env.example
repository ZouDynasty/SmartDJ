# Copy to .env and fill in. .env is gitignored.

# Supabase dashboard → Project Settings → API → Project URL.
# Not a secret: the API only uses it to fetch the public keys that verify
# sign-in tokens.
SUPABASE_URL=

# Signs the short-lived tokens on audio and artwork URLs. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MEDIA_TOKEN_SECRET=
