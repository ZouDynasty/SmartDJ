# Copy to .env and fill in. .env is gitignored.

# Google Cloud console → APIs & Services → Credentials → OAuth client ID
# (type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an "Authorized redirect URI" on the OAuth client exactly.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Where the browser lands after signing in or failing to.
FRONTEND_URL=http://localhost:5173

# Signs the OAuth state cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Users and sessions database (default: data/app.sqlite).
# SMARTDJ_APP_DB=
